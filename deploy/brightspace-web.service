# The web app: the card list, on your phone, always up.
#
# __USER__ and __REPO__ are filled in by install.sh -- do not edit by hand.

[Unit]
Description=Brightspace deadlines web app
After=network-online.target
Wants=network-online.target
# The database lives on the USB stick. Starting without it would serve an
# empty list rather than failing, so require the mount.
RequiresMountsFor=__DATA__

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/scraper
Environment=BRIGHTSPACE_DATA=__DATA__
# Without this, Python holds its output in a buffer whenever it is not
# writing to a screen -- so the log stays empty until the run finishes and
# `journalctl -f` shows nothing while you watch it.
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO__/.venv/bin/python web.py
Restart=on-failure
RestartSec=10

# The session file is a bearer token for the whole uOttawa account, so this
# process gets no more of the machine than it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DATA__
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
