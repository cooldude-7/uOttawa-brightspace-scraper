# One scrape. Started by brightspace-update.timer, not by you.
#
# __USER__ and __REPO__ are filled in by install.sh -- do not edit by hand.

[Unit]
Description=Check Brightspace for new deadlines
After=network-online.target
Wants=network-online.target
RequiresMountsFor=__DATA__

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__REPO__/scraper
Environment=BRIGHTSPACE_DATA=__DATA__
# Without this, Python holds its output in a buffer whenever it is not
# writing to a screen -- so the log stays empty until the run finishes and
# `journalctl -f` shows nothing while you watch it.
Environment=PYTHONUNBUFFERED=1
ExecStart=__REPO__/.venv/bin/python update.py --quiet

# A scrape that hangs must not still be holding the database when the next
# one starts half an hour later.
TimeoutStartSec=20min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DATA__
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
